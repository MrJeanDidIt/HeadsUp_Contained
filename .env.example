# Copy to .env. .env is gitignored.

DEBUG=true
DATABASE_URL=postgresql+asyncpg://headsup:headsup@localhost:5432/headsup
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=America/New_York

# Local development only. The app refuses to start with this true unless DEBUG is also true.
AUTH_DISABLED=true

# Entra ID (fill in when you add auth)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://heads-up

# Canvas — profile > settings > new access token
CANVAS_BASE_URL=https://canvas.fiu.edu
CANVAS_TOKEN=
CANVAS_LOOKAHEAD_DAYS=14

# ntfy — treat the topic name as a secret, make it long and random
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

SCORE_THRESHOLD=10
POLL_INTERVAL_MINUTES=10
